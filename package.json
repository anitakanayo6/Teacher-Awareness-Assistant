{
  "name": "teacher-awareness-assistant",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "tsc --noEmit"
  },
  "dependencies": { "express": "^5.1.0", "react": "^19.1.0", "react-dom": "^19.1.0", "lucide-react": "^0.468.0", "zod": "^3.24.0" },
  "devDependencies": { "@types/express": "^5.0.0", "@types/node": "^24.0.0", "@types/react": "^19.1.0", "@types/react-dom": "^19.1.0", "@vitejs/plugin-react": "^4.4.0", "typescript": "^5.8.0", "vite": "^6.3.0", "tsx": "^4.19.0", "esbuild": "^0.25.0", "@playwright/test": "^1.51.0" }
}
