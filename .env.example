# No environment variables or AI credentials are required for the local demo.
PORT=3000
HOST=127.0.0.1
DATABASE_PATH=./data/teacher-awareness.db
AI_PROVIDER=demo
# Optional: set AI_PROVIDER=openai-compatible and all three below.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
# Set to true only behind HTTPS in deployment.
COOKIE_SECURE=false
# Optional contacts; use your own school's approved details.
EMERGENCY_CONTACT=
SAFEGUARDING_CONTACT=
WELLBEING_CONTACT=
CRISIS_RESOURCES=
